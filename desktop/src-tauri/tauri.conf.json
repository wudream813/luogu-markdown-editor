{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "洛谷 Markdown 编辑器",
  "version": "1.40.2",
  "identifier": "com.wudream813.luogu-markdown-editor",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "洛谷 Markdown & KaTeX 编辑器",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "nsis",
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "洛谷 Markdown & KaTeX 编辑器",
    "longDescription": "面向洛谷题解写作的 Markdown + KaTeX 编辑器，完全离线运行。",
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown 文档",
        "role": "Editor"
      }
    ]
  }
}